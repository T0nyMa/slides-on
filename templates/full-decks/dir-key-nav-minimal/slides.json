      "html": "<style>.d-pastel-card{background:#000;color:#fff;font-family:'Inter','Noto Sans SC','PingFang SC',-apple-system,sans-serif;--font-mono:'JetBrains Mono',monospace}.d-pastel-card .slide>*{position:static;z-index:auto}.d-pastel-card .slide{padding:80px 104px}.t-indigo{background:linear-gradient(135deg,#0f172a 0%,#1e1b4b 100%);color:#fff;--accent:#a5b4fc}.t-cream{background:#F5F0E8;color:#1a1a1a;--accent:#B5392A}.t-crimson{background:linear-gradient(135deg,#7f1d1d 0%,#991b1b 100%);color:#fff;--accent:#fecaca}.t-emerald{background:linear-gradient(135deg,#052e16 0%,#064e3b 100%);color:#ecfdf5;--accent:#6ee7b7}.t-slate{background:linear-gradient(135deg,#0f1923 0%,#1a2942 100%);color:#e6edf3;--accent:#7dd3fc}.t-violet{background:linear-gradient(135deg,#1e0a2e 0%,#2e1065 100%);color:#f5f3ff;--accent:#c4b5fd}.t-white{background:#fff;color:#111216;--accent:#6366f1}.t-charcoal{background:linear-gradient(135deg,#111827 0%,#1f2937 100%);color:#f3f4f6;--accent:#fbbf24}.d-pastel-card .slide .chr-page{position:absolute;top:30px;right:48px;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;font-family:var(--font-mono)}.t-cream .chr-page,.t-white .chr-page{color:#999}.t-indigo .chr-page,.t-crimson .chr-page,.t-emerald .chr-page,.t-slate .chr-page,.t-violet .chr-page,.t-charcoal .chr-page{color:rgba(255,255,255,.38)}.chr-kicker{font-size:12px;font-weight:700;letter-spacing:3.5px;text-transform:uppercase;opacity:.55;margin-bottom:22px;display:flex;align-items:center;gap:14px;color:inherit;font-family:inherit}.chr-kicker::after{content:'';flex:1;max-width:120px;height:1px;background:currentColor;opacity:.3}.chr-title{font-size:160px!important;font-weight:900;line-height:.9;letter-spacing:-5px;margin:0 0 20px;color:inherit;font-family:'Inter','Noto Sans SC',sans-serif!important}.chr-heading{font-size:100px;font-weight:900;line-height:.98;letter-spacing:-3px;margin:0 0 18px;color:inherit;font-family:inherit}.chr-sub{font-size:26px;line-height:1.45;opacity:.72;max-width:900px;font-weight:300;color:inherit;font-family:inherit}.chr-sub strong{font-weight:700;opacity:1}.chr-divider{display:block;width:90px;height:4px;background:currentColor;margin:30px 0;opacity:.85;border-radius:0}.chr-codebox{font-family:var(--font-mono);font-size:16px;line-height:1.9;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:24px 28px;margin-top:24px;white-space:pre;color:inherit}.t-cream .chr-codebox,.t-white .chr-codebox{background:rgba(0,0,0,.05);border-color:rgba(0,0,0,.1)}.d-pastel-card .slide .chr-footer{position:absolute;bottom:34px;left:104px;right:48px;display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:12px;letter-spacing:2px;text-transform:uppercase;opacity:.45;color:inherit}.chr-footer kbd{display:inline-block;padding:2px 10px;margin:0 3px;border:1px solid currentColor;border-radius:4px;font-size:12px}.c-hero-num{font-family:var(--font-mono);font-size:240px!important;font-weight:800;line-height:.9;letter-spacing:-10px}.c-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:56px;margin-top:36px}.c-grid-2>div h3{font-size:28px;font-weight:700;margin-bottom:10px}.c-grid-2>div p{font-size:19px;line-height:1.55;opacity:.72;font-weight:300}</style>\n<section class=\"slide t-indigo is-active\">\n  <div class=\"chr-page\">01 / 08</div>\n  <div style=\"margin:auto 0\">\n    <div class=\"chr-kicker\">Karpathy LLM Wiki</div>\n    <h1 class=\"chr-title\">为什么笔记<br>治不了 <span style=\"color:var(--accent)\">LLM</span></h1>\n    <span class=\"chr-divider\"></span>\n    <p class=\"chr-sub\">8 种背景、8 张幻灯，一个关于如何把 AI 变成「长期记忆外挂」的最短陈述。<strong>按 → 继续。</strong></p>\n  </div>\n  <div class=\"chr-footer\"><span>nav · <kbd>←</kbd> <kbd>→</kbd> · <kbd>space</kbd></span><span>cover</span></div>\n</section>"
