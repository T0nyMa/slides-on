      "type": "html",
      "html": "<section class=\"slide is-active\" style=\"background:linear-gradient(160deg,#08080f,#0e1020 50%,#08080f)\">\n    <style>\n      .d-pastel-card {\n        --bg:#08080f;--surface:rgba(255,255,255,.04);--surface-2:rgba(10,14,30,.7);\n        --border:rgba(255,255,255,.1);--border-strong:rgba(255,255,255,.16);\n        --text-1:#f0ece4;--text-2:#b0a99e;--text-3:#7a746c;\n        --accent:#e8a87c;--accent-2:#7eb8da;--accent-3:#7ed3a4;\n        --grad:linear-gradient(135deg,#e8a87c,#d4a0b9,#b8a4d6);\n        --radius:20px;--shadow:0 8px 32px rgba(0,0,0,.3);\n        --shadow-lg:0 16px 48px rgba(0,0,0,.5);\n        --font-display:'Inter','Noto Sans SC',sans-serif;\n        --font-serif:'Inter','Noto Sans SC',sans-serif;\n        background:#08080f;font-family:'Inter','Noto Sans SC',-apple-system,sans-serif;\n      }\n      @keyframes gdDrift{0%{transform:translate(0,0) scale(1)}100%{transform:translate(25px,-20px) scale(1.08)}}@keyframes gdRainbow{0%{background-position:0% center}100%{background-position:200% center}}\n    </style>\n    <div style=\"position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden\">\n      <div style=\"position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(126,184,218,.55),transparent 70%);top:-12%;left:-6%;animation:gdDrift 22s ease-in-out infinite alternate\"></div>\n      <div style=\"position:absolute;width:460px;height:460px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(232,168,124,.45),transparent 70%);top:55%;right:-8%;animation:gdDrift 22s ease-in-out infinite alternate;animation-delay:-6s\"></div>\n      <div style=\"position:absolute;width:420px;height:420px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(184,164,214,.4),transparent 70%);bottom:-8%;left:30%;animation:gdDrift 22s ease-in-out infinite alternate;animation-delay:-11s\"></div>\n    </div>\n    <svg viewBox=\"0 0 1600 900\" style=\"position:absolute;inset:0;width:100%;height:100%;opacity:.38;z-index:1\" xmlns=\"http://www.w3.org/2000/svg\">\n      <g stroke=\"#7eb8da\" stroke-width=\"1\" stroke-opacity=\".5\" fill=\"none\">\n        <line x1=\"300\" y1=\"200\" x2=\"520\" y2=\"340\"/>\n        <line x1=\"520\" y1=\"340\" x2=\"780\" y2=\"260\"/>\n        <line x1=\"780\" y1=\"260\" x2=\"1040\" y2=\"420\"/>\n        <line x1=\"520\" y1=\"340\" x2=\"640\" y2=\"560\"/>\n        <line x1=\"640\" y1=\"560\" x2=\"900\" y2=\"620\"/>\n        <line x1=\"900\" y1=\"620\" x2=\"1040\" y2=\"420\"/>\n        <line x1=\"1040\" y1=\"420\" x2=\"1260\" y2=\"300\"/>\n        <line x1=\"1260\" y1=\"300\" x2=\"1380\" y2=\"500\"/>\n        <line x1=\"900\" y1=\"620\" x2=\"1120\" y2=\"720\"/>\n        <line x1=\"300\" y1=\"200\" x2=\"200\" y2=\"420\"/>\n        <line x1=\"200\" y1=\"420\" x2=\"360\" y2=\"640\"/>\n        <line x1=\"360\" y1=\"640\" x2=\"640\" y2=\"560\"/>\n      </g>\n      <g>\n        <circle cx=\"300\" cy=\"200\" r=\"10\" fill=\"#e8a87c\"/>\n        <circle cx=\"520\" cy=\"340\" r=\"14\" fill=\"#7eb8da\"/>\n        <circle cx=\"780\" cy=\"260\" r=\"9\" fill=\"#7ed3a4\"/>\n        <circle cx=\"1040\" cy=\"420\" r=\"18\" fill=\"#b8a4d6\"/>\n        <circle cx=\"640\" cy=\"560\" r=\"11\" fill=\"#d4a0b9\"/>\n        <circle cx=\"900\" cy=\"620\" r=\"12\" fill=\"#e8a87c\"/>\n        <circle cx=\"1260\" cy=\"300\" r=\"8\" fill=\"#7ed3a4\"/>\n        <circle cx=\"1380\" cy=\"500\" r=\"10\" fill=\"#7eb8da\"/>\n        <circle cx=\"1120\" cy=\"720\" r=\"9\" fill=\"#d4a0b9\"/>\n        <circle cx=\"200\" cy=\"420\" r=\"8\" fill=\"#b8a4d6\"/>\n        <circle cx=\"360\" cy=\"640\" r=\"11\" fill=\"#7eb8da\"/>\n      </g>\n    </svg>\n    <div class=\"chr-page\" style=\"position:absolute;top:28px;right:40px;z-index:3;font-size:12px;letter-spacing:.25em\">01 · 08</div>\n    <div style=\"margin-top:auto\">\n      <p class=\"chr-kicker\" style=\"font-size:13px;letter-spacing:.2em;margin-bottom:10px\">Tech Sharing · 纯干货</p>\n      <h1 class=\"chr-title\" style=\"font-size:88px;line-height:1.08;margin:10px 0\"><span style=\"background:linear-gradient(90deg,#ff0080,#ff4d00,#ff9900,#ffe600,#00c853,#0091ea,#6200ea,#ff0080);background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:gdRainbow 4s linear infinite\">手把手用 Graphify<br>搭建个人知识图谱</span></h1>\n      <p class=\"chr-sub\" style=\"margin-top:20px;font-size:22px;font-weight:300;line-height:1.65;max-width:850px\">一行命令 · 全多模态 · 诚实审计 —— <span style=\"color:var(--accent);font-weight:500\">把任何文件夹变成可导航的知识网络。</span></p>\n      <p class=\"chr-kicker\" style=\"margin-top:26px;font-size:13px;letter-spacing:.2em\">↑ 背景就是 Graphify 真实跑出来的知识图谱</p>\n    </div>\n  </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"slide\" style=\"background:linear-gradient(160deg,#08080f,#0e1020 50%,#08080f)\">\n    <div style=\"position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden\">\n      <div style=\"position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(126,184,218,.55),transparent 70%);top:-12%;left:-6%;animation:gdDrift 22s ease-in-out infinite alternate\"></div>\n      <div style=\"position:absolute;width:460px;height:460px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(232,168,124,.45),transparent 70%);top:55%;right:-8%;animation:gdDrift 22s ease-in-out infinite alternate;animation-delay:-6s\"></div>\n    </div>\n    <div class=\"chr-page\" style=\"position:absolute;top:28px;right:40px;z-index:3;font-size:12px;letter-spacing:.25em\">02 · 08</div>\n    <div style=\"margin:auto 0\">\n      <div class=\"chr-kicker\" style=\"font-size:13px;letter-spacing:.2em;margin-bottom:8px\">Part 01</div>\n      <h1 class=\"chr-title\" style=\"font-size:120px;line-height:1.05\">Why <span class=\"c-grad\">Graph</span>?</h1>\n      <p class=\"chr-sub\" style=\"font-size:22px;font-weight:300;line-height:1.65\">folder → tree → graph，人类认知的下一步</p>\n    </div>\n  </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"slide\" style=\"background:linear-gradient(160deg,#08080f,#0e1020 50%,#08080f)\">\n    <div style=\"position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden\">\n      <div style=\"position:absolute;width:460px;height:460px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(232,168,124,.45),transparent 70%);top:55%;right:-8%;animation:gdDrift 22s ease-in-out infinite alternate;animation-delay:-6s\"></div>\n      <div style=\"position:absolute;width:420px;height:420px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(184,164,214,.4),transparent 70%);bottom:-8%;left:30%;animation:gdDrift 22s ease-in-out infinite alternate;animation-delay:-11s\"></div>\n    </div>\n    <div class=\"chr-page\" style=\"position:absolute;top:28px;right:40px;z-index:3;font-size:12px;letter-spacing:.25em\">03 · 08</div>\n    <p class=\"chr-kicker\" style=\"font-size:13px;letter-spacing:.2em;margin-bottom:6px\">Feature Map</p>\n    <h2 class=\"chr-heading\">一个工具，<span class=\"c-grad\">四件事</span></h2>\n    <div class=\"g4\" style=\"margin-top:24px;gap:14px\">\n      <div class=\"c-glass\" style=\"background:rgba(232,168,124,.06);border-color:rgba(232,168,124,.2);backdrop-filter:blur(20px) saturate(160%);border-radius:20px\"><div style=\"font-size:30px\">📂</div><h4 style=\"margin:10px 0 6px;font-weight:600;font-size:18px\">Folder Ingest</h4><p class=\"c-body\" style=\"font-size:13px;line-height:1.55\">递归扫描任意路径，支持 md / pdf / 代码 / 图片</p></div>\n      <div class=\"c-glass\" style=\"background:rgba(126,184,218,.06);border-color:rgba(126,184,218,.2);backdrop-filter:blur(20px) saturate(160%);border-radius:20px\"><div style=\"font-size:30px\">🧠</div><h4 style=\"margin:10px 0 6px;font-weight:600;font-size:18px\">Entity Extract</h4><p class=\"c-body\" style=\"font-size:13px;line-height:1.55\">用 LLM 抽概念、人物、事件、关系</p></div>\n      <div class=\"c-glass\" style=\"background:rgba(126,211,164,.06);border-color:rgba(126,211,164,.2);backdrop-filter:blur(20px) saturate(160%);border-radius:20px\"><div style=\"font-size:30px\">🕸️</div><h4 style=\"margin:10px 0 6px;font-weight:600;font-size:18px\">Force Graph</h4><p class=\"c-body\" style=\"font-size:13px;line-height:1.55\">D3 力导向，点击即跳转原文</p></div>\n      <div class=\"c-glass\" style=\"backdrop-filter:blur(20px) saturate(160%);border-radius:20px\"><div style=\"font-size:30px\">🔍</div><h4 style=\"margin:10px 0 6px;font-weight:600;font-size:18px\">Audit Trail</h4><p class=\"c-body\" style=\"font-size:13px;line-height:1.55\">每条边都能追溯到 source span</p></div>\n    </div>\n    <div class=\"c-glass\" style=\"margin-top:24px;background:rgba(232,168,124,.06);border-color:rgba(232,168,124,.2);backdrop-filter:blur(20px) saturate(160%);border-radius:20px\"><p style=\"font-size:18px;line-height:1.6\">它不是「又一个 RAG」—— 它是 <span style=\"color:var(--accent);font-weight:500\">把检索结果画出来，让你一眼就知道信息长什么样</span>。</p></div>\n  </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"slide\" style=\"background:linear-gradient(160deg,#08080f,#0e1020 50%,#08080f)\">\n    <div style=\"position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden\">\n      <div style=\"position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(126,184,218,.55),transparent 70%);top:-12%;left:-6%;animation:gdDrift 22s ease-in-out infinite alternate\"></div>\n    </div>\n    <div class=\"chr-page\" style=\"position:absolute;top:28px;right:40px;z-index:3;font-size:12px;letter-spacing:.25em\">04 · 08</div>\n    <p class=\"chr-kicker\" style=\"font-size:13px;letter-spacing:.2em;margin-bottom:6px\">One command</p>\n    <h2 class=\"chr-heading\">从 0 到图谱，<span class=\"c-grad\">大概 90 秒</span></h2>\n    <p style=\"font-family:'JetBrains Mono',monospace;font-size:32px;font-weight:700;color:var(--accent-3);text-shadow:0 0 30px rgba(126,211,164,.45),0 0 60px rgba(126,211,164,.15);letter-spacing:-.01em;margin:16px 0 22px\">$ graphify ~/notes --out ./graph</p>\n    <pre class=\"c-codebox\" style=\"font-size:14px;line-height:1.8;border-radius:14px;background:rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.08);color:#d8d4c8\"><span class=\"cm\"># graphify.config.yaml</span>\n<span class=\"kw\">ingest</span>:\n  paths: [<span class=\"st\">~/notes</span>, <span class=\"st\">~/code/docs</span>]\n  include: [<span class=\"st\">\"*.md\"</span>, <span class=\"st\">\"*.pdf\"</span>, <span class=\"st\">\"*.py\"</span>]\n\n<span class=\"kw\">extract</span>:\n  model: <span class=\"st\">claude-opus-4-6</span>\n  schema: [<span class=\"st\">concept</span>, <span class=\"st\">person</span>, <span class=\"st\">event</span>, <span class=\"st\">relation</span>]\n\n<span class=\"kw\">render</span>:\n  engine: <span class=\"st\">d3-force</span>\n  audit: <span class=\"fn\">true</span>     <span class=\"cm\"># 每条边带 source span</span></pre>\n  </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"slide\" style=\"background:linear-gradient(160deg,#08080f,#0e1020 50%,#08080f)\">\n    <div style=\"position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden\">\n      <div style=\"position:absolute;width:420px;height:420px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(184,164,214,.4),transparent 70%);bottom:-8%;left:30%;animation:gdDrift 22s ease-in-out infinite alternate;animation-delay:-11s\"></div>\n    </div>\n    <div class=\"chr-page\" style=\"position:absolute;top:28px;right:40px;z-index:3;font-size:12px;letter-spacing:.25em\">05 · 08</div>\n    <p class=\"chr-kicker\" style=\"font-size:13px;letter-spacing:.2em;margin-bottom:6px\">Efficiency Race</p>\n    <h2 class=\"chr-heading\">没有知识库 vs 有知识库</h2>\n    <div style=\"max-width:900px;margin-top:30px\">\n      <div style=\"display:flex;align-items:center;gap:16px;margin-bottom:20px\">\n        <div style=\"width:110px;text-align:right;font-weight:700;color:#e07070\">没有<br>知识库</div>\n        <div style=\"flex:1;position:relative;height:70px;background:rgba(224,112,112,.06);border:1px solid rgba(224,112,112,.2);border-radius:16px\">\n          <div style=\"position:absolute;left:16px;top:50%;transform:translateY(-50%);font-size:32px\">🛵</div>\n          <div style=\"position:absolute;left:72px;top:50%;transform:translateY(-50%);color:#e07070;font-size:14px\">反复喂信息…整理…又忘了…</div>\n        </div>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:16px\">\n        <div style=\"width:110px;text-align:right;font-weight:700;color:var(--accent-3)\">有<br>知识库</div>\n        <div style=\"flex:1;position:relative;height:70px;background:rgba(126,211,164,.06);border:1px solid rgba(126,211,164,.25);border-radius:16px\">\n          <div style=\"position:absolute;right:16px;top:50%;transform:translateY(-50%);font-size:32px\">🏎️</div>\n          <div style=\"position:absolute;right:72px;top:50%;transform:translateY(-50%);color:var(--accent-3);font-size:14px\">AI 自己找 → 确认 → 干活!</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"c-grid-3\" style=\"margin-top:36px\">\n      <div class=\"c-glass\" style=\"background:rgba(232,168,124,.06);border-color:rgba(232,168,124,.2);backdrop-filter:blur(20px) saturate(160%);border-radius:20px;text-align:center\"><span class=\"c-grad\" style=\"font-size:120px;font-weight:900;letter-spacing:-.04em;line-height:1;display:block\">5x</span><p class=\"c-body\" style=\"margin-top:6px;font-size:14px\">速度提升</p></div>\n      <div class=\"c-glass\" style=\"background:rgba(126,211,164,.06);border-color:rgba(126,211,164,.2);backdrop-filter:blur(20px) saturate(160%);border-radius:20px;text-align:center\"><span class=\"c-grad\" style=\"font-size:120px;font-weight:900;letter-spacing:-.04em;line-height:1;display:block\">-80%</span><p class=\"c-body\" style=\"margin-top:6px;font-size:14px\">重复喂信息</p></div>\n      <div class=\"c-glass\" style=\"background:rgba(126,184,218,.06);border-color:rgba(126,184,218,.2);backdrop-filter:blur(20px) saturate(160%);border-radius:20px;text-align:center\"><span class=\"c-grad\" style=\"font-size:120px;font-weight:900;letter-spacing:-.04em;line-height:1;display:block\">∞</span><p class=\"c-body\" style=\"margin-top:6px;font-size:14px\">记忆持久化</p></div>\n    </div>\n  </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"slide\" style=\"background:linear-gradient(160deg,#08080f,#0e1020 50%,#08080f)\">\n    <div style=\"position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden\">\n      <div style=\"position:absolute;width:460px;height:460px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(232,168,124,.45),transparent 70%);top:55%;right:-8%;animation:gdDrift 22s ease-in-out infinite alternate;animation-delay:-6s\"></div>\n    </div>\n    <div class=\"chr-page\" style=\"position:absolute;top:28px;right:40px;z-index:3;font-size:12px;letter-spacing:.25em\">06 · 08</div>\n    <p class=\"chr-kicker\" style=\"font-size:13px;letter-spacing:.2em;margin-bottom:6px\">Pipeline</p>\n    <h2 class=\"chr-heading\">端到端 <span class=\"c-grad\">4 步走</span></h2>\n    <div style=\"display:flex;align-items:center;justify-content:center;gap:8px;margin-top:36px\">\n      <div class=\"c-glass\" style=\"flex:1;text-align:center;backdrop-filter:blur(20px) saturate(160%);border-radius:20px\"><div style=\"font-size:34px\">📂</div><div style=\"font-weight:600;margin-top:8px;font-size:16px\">Scan</div><div class=\"c-body\" style=\"font-size:13px\">递归读文件</div></div>\n      <div style=\"color:var(--text-3);font-size:24px\">→</div>\n      <div class=\"c-glass\" style=\"flex:1;text-align:center;background:rgba(126,184,218,.06);border-color:rgba(126,184,218,.2);backdrop-filter:blur(20px) saturate(160%);border-radius:20px\"><div style=\"font-size:34px\">🔬</div><div style=\"font-weight:600;margin-top:8px;font-size:16px\">Extract</div><div class=\"c-body\" style=\"font-size:13px\">LLM 抽实体</div></div>\n      <div style=\"color:var(--text-3);font-size:24px\">→</div>\n      <div class=\"c-glass\" style=\"flex:1;text-align:center;background:rgba(126,211,164,.06);border-color:rgba(126,211,164,.2);backdrop-filter:blur(20px) saturate(160%);border-radius:20px\"><div style=\"font-size:34px\">🕸️</div><div style=\"font-weight:600;margin-top:8px;font-size:16px\">Build</div><div class=\"c-body\" style=\"font-size:13px\">构图 + 去重</div></div>\n      <div style=\"color:var(--text-3);font-size:24px\">→</div>\n      <div class=\"c-glass\" style=\"flex:1;text-align:center;background:rgba(232,168,124,.06);border-color:rgba(232,168,124,.2);backdrop-filter:blur(20px) saturate(160%);border-radius:20px\"><div style=\"font-size:34px\">🎨</div><div style=\"font-weight:600;margin-top:8px;font-size:16px\">Render</div><div class=\"c-body\" style=\"font-size:13px\">D3 交互图</div></div>\n    </div>\n    <div class=\"c-glass\" style=\"margin-top:32px;backdrop-filter:blur(20px) saturate(160%);border-radius:20px\"><p style=\"font-size:16px;line-height:1.6;color:var(--text-2)\">每一步都有 audit log：你永远知道某个节点为什么存在、它来自哪个文件的哪一行。</p></div>\n  </section>"
    },
    {
      "type": "html",
      "html": "<section class=\"slide\" style=\"background:linear-gradient(160deg,#08080f,#0e1020 50%,#08080f)\">\n    <div style=\"position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden\">\n      <div style=\"position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(126,184,218,.55),transparent 70%);top:-12%;left:-6%;animation:gdDrift 22s ease-in-out infinite alternate\"></div>\n      <div style=\"position:absolute;width:420px;height:420px;border-radius:50%;filter:blur(110px);opacity:.35;background:radial-gradient(circle,rgba(184,164,214,.4),transparent 70%);bottom:-8%;left:30%;animation:gdDrift 22s ease-in-out infinite alternate;animation-delay:-11s\"></div>\n    </div>\n    <div class=\"chr-page\" style=\"position:absolute;top:28px;right:40px;z-index:3;font-size:12px;letter-spacing:.25em\">07 · 08</div>\n    <p class=\"chr-kicker\" style=\"font-size:13px;letter-spacing:.2em;margin-bottom:10px\">Try it tonight</p>\n    <h1 class=\"chr-title\" style=\"font-size:80px;line-height:1.08;margin:10px 0\">Graphify <span class=\"c-grad\">your folders</span></h1>\n    <p style=\"font-family:'JetBrains Mono',monospace;font-size:32px;font-weight:700;color:var(--accent-3);text-shadow:0 0 30px rgba(126,211,164,.45),0 0 60px rgba(126,211,164,.15);letter-spacing:-.01em;margin-top:22px\">$ npm i -g @lewis/graphify</p>\n    <p style=\"font-family:'JetBrains Mono',monospace;font-size:32px;font-weight:700;color:var(--accent);text-shadow:0 0 30px rgba(232,168,124,.45);letter-spacing:-.01em;margin-top:10px\">$ graphify ~/obsidian-vault</p>\n    <div style=\"margin-top:32px\">\n      <span class=\"c-badge\">#knowledge-graph</span>\n      <span class=\"c-badge\">#open-source</span>\n      <span class=\"c-badge\">#claude-agent</span>\n      <span class=\"c-badge\">#obsidian</span>\n      <span class=\"c-badge\">#d3-force</span>\n    </div>\n  </section>"
