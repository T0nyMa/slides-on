>\n      <div style=\"flex:1.3;border:2px solid #B5392A;border-radius:1.5cqi;padding:2cqi 2.5cqi;background:#B5392A;color:#fff;display:flex;gap:2cqi;align-items:center;box-shadow:0 1cqi 3cqi rgba(181,57,42,.28)\">\n        <div style=\"flex:none;font-size:1.6cqi;font-weight:800;letter-spacing:.2em;color:rgba(255,255,255,.6);text-transform:uppercase;writing-mode:vertical-lr\">STEP 03</div>\n        <div>\n          <div style=\"font-size:2.5cqi;font-weight:900;color:#fff;margin-bottom:.3cqi\">Wiki 化 <span style=\"font-size:2cqi;opacity:.7;font-weight:600\">· CORE</span></div>\n          <div style=\"font-size:1.7cqi;color:rgba(255,255,255,.88);line-height:1.5\">结构化成双链笔记，实体、关系、属性全在一起</div>\n        </div>\n      </div>\n      <div style=\"flex:1;border:2px solid #1a1a1a;border-radius:1.5cqi;padding:2cqi 2.5cqi;background:#fff;display:flex;gap:2cqi;align-items:center\">\n        <div style=\"flex:none;font-size:1.6cqi;font-weight:800;letter-spacing:.2em;color:#aaa;text-transform:uppercase;writing-mode:vertical-lr\">STEP 04</div>\n        <div>\n          <div style=\"font-size:2.5cqi;font-weight:900;color:#111;margin-bottom:.3cqi\">使用</div>\n          <div style=\"font-size:1.7cqi;color:#555;line-height:1.5\">Agent 随时检索、回答、再写入</div>\n        </div>\n      </div>\n    </div>\n    <div style=\"position:absolute;left:4.5cqi;right:4.5cqi;bottom:3cqi;font-size:1.7cqi;color:#666;letter-spacing:.15em;text-transform:uppercase;border-top:1px solid #cec8be;padding-top:1.5cqi;display:flex;justify-content:space-between\"><span>Pipeline · Steps</span><span>03 / 07</span></div>\n  </section>"
